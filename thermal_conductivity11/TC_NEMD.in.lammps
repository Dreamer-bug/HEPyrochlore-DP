# use fix heat to add/subtract energy from 2 regions

# setting
variable        T equal 300
variable        dt equal 0.001
variable        P  equal 0.0
variable        power  equal  0.5

units           metal
dimension       3
boundary        p p p
atom_style      atomic


# Read structure
read_data       lmp.La_con24.conf

# DPMD trained data
pair_style      deepmd graph_LNSEGY_revised.pb
pair_coeff      * *

# Set up thermo output
thermo          50
thermo_style    custom step temp pe etotal press vol

velocity	all create ${T} 654321
# Initial NPT run for equilibration to room temperature and zero pressure
fix             1 all npt temp ${T} ${T} 0.1 iso ${P} ${P} 1.0
dump            1 all custom 50 dump_${T}K_NPT.atom id type xs ys zs vx vy vz fx fy fz
timestep        ${dt}
run             10000
write_data      equilibrated_structure.lmp
unfix           1
undump          1


reset_timestep  0
# heat layers
region          cold block INF INF INF INF 0.0 3.0
region          hot block  INF INF INF INF 130.0 133.0

compute         Thot all temp/region hot
compute         Tcold all temp/region cold

# 2nd equilibration run

fix		2 all nve
#fix             3 all langevin ${T} ${T} 0.1 54321
fix             hot all heat 5 ${power} region hot
fix             cold all heat 5 -${power} region cold

thermo_style    custom step temp c_Thot c_Tcold
thermo	        50
run             40000

# thermal conductivity calculation

compute		ke all ke/atom
variable	temp atom c_ke/0.0001292355

compute         layers all chunk/atom bin/1d z lower 0.01 units reduced
fix		3 all ave/chunk 10 500 5000 layers v_temp file profile.txt

dump            2 all custom 50 dump_${T}K_NVE.atom id type xs ys zs vx vy vz v_temp
run             300000

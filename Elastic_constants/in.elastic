# Compute elastic constant tensor for a crystal at target temperature
#
#  This script uses the following three include files.
#
#   init.in      read initial structure  
#
#   poteantial.eam    define potential
#
#   displace.in    deform the crystal

include init.in

# Compute initial state

variable thermostat equal 1
include potential_npt.dp
run ${nequil}

if "${adiabatic} == 1" &
then "variable thermostat equal 0" &
else "variable thermostat equal 1"

print ${thermostat}

include potential.dp
run ${nrun}

variable pxx0 equal f_avp[1]
variable pyy0 equal f_avp[2]
variable pzz0 equal f_avp[3]
variable pxy0 equal f_avp[4]
variable pxz0 equal f_avp[5]
variable pyz0 equal f_avp[6]

variable tmp equal lx
variable lx0 equal ${tmp}
variable tmp equal ly
variable ly0 equal ${tmp}
variable tmp equal lz
variable lz0 equal ${tmp}

# These formulas define the derivatives with strain components
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
variable d5 equal -(v_pxz1-${pxz0})/(v_delta/v_len0)*${cfac}
variable d6 equal -(v_pxy1-${pxy0})/(v_delta/v_len0)*${cfac}

# Write restart
write_restart restart.equil

# uxx Perturbation

variable dir equal 1
include displace.in

# uyy Perturbation

variable dir equal 2
include displace.in

# uzz Perturbation

variable dir equal 3
include displace.in

# uyz Perturbation

variable dir equal 4
include displace.in

# uxz Perturbation

variable dir equal 5
include displace.in

# uxy Perturbation

variable dir equal 6
include displace.in

# Output final values

variable C11all equal ${C11}
variable C22all equal ${C22}
variable C33all equal ${C33}

variable C12all equal 0.5*(${C12}+${C21})
variable C13all equal 0.5*(${C13}+${C31})
variable C23all equal 0.5*(${C23}+${C32})

variable C44all equal ${C44}
variable C55all equal ${C55}
variable C66all equal ${C66}

variable C14all equal 0.5*(${C14}+${C41})
variable C15all equal 0.5*(${C15}+${C51})
variable C16all equal 0.5*(${C16}+${C61})

variable C24all equal 0.5*(${C24}+${C42})
variable C25all equal 0.5*(${C25}+${C52})
variable C26all equal 0.5*(${C26}+${C62})

variable C34all equal 0.5*(${C34}+${C43})
variable C35all equal 0.5*(${C35}+${C53})
variable C36all equal 0.5*(${C36}+${C63})

variable C45all equal 0.5*(${C45}+${C54})
variable C46all equal 0.5*(${C46}+${C64})
variable C56all equal 0.5*(${C56}+${C65})

# Average moduli for cubic crystals

variable C11cubic equal (${C11all}+${C22all}+${C33all})/3.0
variable C12cubic equal (${C12all}+${C13all}+${C23all})/3.0
variable C44cubic equal (${C44all}+${C55all}+${C66all})/3.0

variable bulkmodulus equal (${C11cubic}+2*${C12cubic})/3.0
variable shearmodulus1 equal ${C44cubic}
variable shearmodulus2 equal (${C11cubic}-${C12cubic})/2.0
variable poissonratio equal 1.0/(1.0+${C11cubic}/${C12cubic})
  
print "========================================="
print "Components of the Elastic Constant Tensor"
print "========================================="

print "Elastic Constant C11all = ${C11all} "
print "Elastic Constant C22all = ${C22all} "
print "Elastic Constant C33all = ${C33all} "

print "Elastic Constant C12all = ${C12all} "
print "Elastic Constant C13all = ${C13all} "
print "Elastic Constant C23all = ${C23all} "

print "Elastic Constant C44all = ${C44all} "
print "Elastic Constant C55all = ${C55all} "
print "Elastic Constant C66all = ${C66all} "

print "Elastic Constant C14all = ${C14all} "
print "Elastic Constant C15all = ${C15all} "
print "Elastic Constant C16all = ${C16all} "

print "Elastic Constant C24all = ${C24all} "
print "Elastic Constant C25all = ${C25all} "
print "Elastic Constant C26all = ${C26all} "

print "Elastic Constant C34all = ${C34all} "
print "Elastic Constant C35all = ${C35all} "
print "Elastic Constant C36all = ${C36all} "

print "Elastic Constant C45all = ${C45all} "
print "Elastic Constant C46all = ${C46all} "
print "Elastic Constant C56all = ${C56all} "

print "========================================="
print "Average properties for a cubic crystal"
print "========================================="

print "Bulk Modulus = ${bulkmodulus}"
print "Shear Modulus 1 = ${shearmodulus1}"
print "Shear Modulus 2 = ${shearmodulus2}"
print "Poisson Ratio = ${poissonratio}"

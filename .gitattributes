# Normalize text files across operating systems.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.in text eol=lf
*.lmp text eol=lf
*.lammps text eol=lf
*.conf text eol=lf
*.raw text eol=lf

# Scientific binary data and large generated test results.
*.npy filter=lfs diff=lfs merge=lfs -text
DP_model_training/test_results/*.out filter=lfs diff=lfs merge=lfs -text
*.pb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
